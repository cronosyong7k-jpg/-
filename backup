<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>重庆旅行指南 | Chongqing Travel Guide</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    .glass-nav {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(12px);
    }
    .badge-poi { background-color: #e0f2fe; color: #0369a1; }
    .badge-food { background-color: #fef3c7; color: #b45309; }
    .badge-transport { background-color: #f3e8ff; color: #6b21a8; }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">

  <!-- Header / Navigation -->
  <header class="sticky top-0 z-50 glass-nav border-b border-slate-200">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-rose-500 to-amber-500 flex items-center justify-center text-white font-bold text-lg shadow-md">
          渝
        </div>
        <div>
          <h1 class="font-bold text-slate-900 leading-tight">重庆旅行指南</h1>
          <p class="text-xs text-slate-500">Chongqing Travel Guide</p>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex bg-slate-100 p-1 rounded-xl text-sm font-medium">
        <button id="nav-locations" onclick="switchTab('locations')" class="flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm">
          <i class="fa-solid fa-map-location-dot text-rose-500"></i>
          <span>地标景点</span>
        </button>
        <button id="nav-itinerary" onclick="switchTab('itinerary')" class="flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900">
          <i class="fa-solid fa-calendar-days text-amber-500"></i>
          <span>行程规划</span>
        </button>
      </nav>
    </div>
  </header>

  <!-- Main Content Area -->
  <main class="flex-grow max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">

    <!-- LOCATIONS VIEW -->
    <section id="view-locations" class="space-y-6">
      <!-- Search & Filter Controls -->
      <div class="flex flex-col sm:flex-row gap-4 items-center justify-between bg-white p-4 rounded-2xl shadow-sm border border-slate-100">
        <div class="relative w-full sm:w-80">
          <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400"></i>
          <input type="text" id="search-input" oninput="filterLocations()" placeholder="搜索景点或地址..." class="w-full pl-10 pr-4 py-2 bg-slate-50 rounded-xl border border-slate-200 text-sm focus:outline-none focus:ring-2 focus:ring-rose-500/20 focus:border-rose-500">
        </div>
        <div class="flex items-center space-x-2 w-full sm:w-auto overflow-x-auto pb-1 sm:pb-0" id="category-filters">
          <!-- Dynamically populated categories -->
        </div>
      </div>

      <!-- Locations Grid -->
      <div id="locations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Location cards injected via JS -->
      </div>
    </section>

    <!-- ITINERARY VIEW -->
    <section id="view-itinerary" class="hidden space-y-8">
      <div class="bg-gradient-to-r from-rose-500 to-amber-500 rounded-2xl p-6 text-white shadow-lg">
        <h2 class="text-2xl font-bold mb-1">山城探索之旅 10日行程概览</h2>
        <p class="text-rose-100 text-sm">串联魔幻九宫格火锅、崖壁步道与璀璨夜景</p>
      </div>

      <div id="itinerary-timeline" class="space-y-8">
        <!-- Itinerary days injected via JS -->
      </div>
    </section>

  </main>

  <!-- Location Detail Modal -->
  <div id="modal-backdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center p-4" onclick="closeModal()">
    <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl transform scale-95 transition-transform duration-300 space-y-4" onclick="event.stopPropagation()">
      <div class="flex justify-between items-start">
        <span id="modal-category" class="px-3 py-1 bg-rose-50 text-rose-600 rounded-full text-xs font-semibold"></span>
        <button onclick="closeModal()" class="w-8 h-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-500 hover:bg-slate-200">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <h3 id="modal-title" class="text-2xl font-bold text-slate-900"></h3>
      <div class="flex items-center text-xs text-slate-500 space-x-1">
        <i class="fa-solid fa-location-dot text-rose-500"></i>
        <span id="modal-address"></span>
      </div>
      <p id="modal-description" class="text-slate-600 text-sm leading-relaxed bg-slate-50 p-4 rounded-2xl border border-slate-100"></p>
      <div class="pt-2 flex justify-end">
        <button onclick="closeModal()" class="px-5 py-2 bg-slate-900 text-white text-sm font-medium rounded-xl hover:bg-slate-800 transition-colors">关闭</button>
      </div>
    </div>
  </div>

  <script>
    // Embedded JSON Data
    const travelData = {
  "locations": [
    {
      "id": "cq_hyd",
      "name": "洪崖洞民俗风貌区",
      "city": "重庆",
      "category": "地标",
      "folder": "images/cq/hyd",
      "address": "重庆市渝中区嘉陵江滨江路88号",
      "description": "现实版《千与千寻》汤屋，夜晚灯火辉煌，是重庆最具代表性的夜景之一。夜景最佳拍摄点在千厮门大桥或洪崖洞天桥。"
    },
    {
      "id": "cq_jfb",
      "name": "解放碑步行街",
      "city": "重庆",
      "category": "商业街",
      "folder": "images/cq/jfb",
      "address": "重庆市渝中区民族路177号",
      "description": "重庆的精神地标与繁华商业中心，也是周边美食集中地。可以在历史纪念碑前打卡，感受现代都市与历史交融的氛围。"
    },
    {
      "id": "cq_lzb",
      "name": "李子坝单轨穿楼观景平台",
      "city": "重庆",
      "category": "奇观",
      "folder": "images/cq/lzb",
      "address": "重庆市渝中区李子坝正街",
      "description": "亲眼见证轻轨从居民楼中穿墙而过的魔幻景观，是重庆魔幻地形的经典代表。"
    },
    {
      "id": "cq_cjsd",
      "name": "长江索道景区",
      "city": "重庆",
      "category": "体验",
      "folder": "images/cq/cjsd",
      "address": "重庆市渝中区新华路151号",
      "description": "横跨长江的“空中巴士”，可以从空中俯瞰两岸风光与山城景色，体验独特的过江方式。"
    },
    {
      "id": "cq_cqk",
      "name": "磁器口古镇",
      "city": "重庆",
      "category": "古镇",
      "folder": "images/cq/cqk",
      "address": "重庆市沙坪坝区磁南街1号",
      "description": "千年巴渝古镇，陈麻花和酸辣粉必尝。"
    },
    {
      "id": "cq_scx",
      "name": "山城巷传统风貌区（山城步道）",
      "city": "重庆",
      "category": "步道",
      "folder": "images/cq/scx",
      "address": "重庆市渝中区南纪门街道山城巷",
      "description": "建在悬崖上的栈道与步道，老重庆街巷氛围浓厚，傍晚红灯笼亮起时景色很美。"
    },
    {
      "id": "cq_elec",
      "name": "鹅岭二厂",
      "city": "重庆",
      "category": "文创区",
      "folder": "images/cq/elec",
      "address": "重庆市渝中区鹅岭正街1号",
      "description": "文创公园，电影《从你的全世界路过》取景地。"
    },
    {
      "id": "cq_bxj",
      "name": "白象居",
      "city": "重庆",
      "category": "街区",
      "folder": "images/cq/bxj",
      "address": "重庆市渝中区白象街1-6号",
      "description": "拍摄长江索道穿楼的最佳地点，充满老重庆母城记忆。"
    }
  ],
  "itinerary": [
    {
      "day": 1,
      "title": "Day 1 (11月7日): 抵达重庆 & 步道初探",
      "city": "重庆",
      "steps": [
        {
          "time": "14:00",
          "activity": "抵达重庆并入住酒店",
          "type": "Transport",
          "notes": "建议入住渝中区靠近轨道交通站酒店，方便出行"
        },
        {
          "time": "16:30",
          "activity": "十八梯传统风貌区",
          "type": "POI",
          "locationId": "cq_sbt",
          "notes": "体验山城步道，游览传统吊脚楼建筑"
        },
        {
          "time": "19:00",
          "activity": "解放碑 & 八一好吃街",
          "type": "Food",
          "locationId": "cq_jfb",
          "notes": "品尝九宫格九村烤脑花、酸辣粉及重庆老火锅"
        }
      ]
    },
    {
      "day": 2,
      "title": "Day 2 (11月8日): 魔幻高空轻轨与夜景",
      "city": "重庆",
      "steps": [
        {
          "time": "09:30",
          "activity": "李子坝轻轨穿楼",
          "type": "POI",
          "locationId": "cq_lzb",
          "notes": "在一楼观景平台拍摄轻轨穿过19层居民楼奇观"
        },
        {
          "time": "14:00",
          "activity": "磁器口古镇",
          "type": "POI",
          "locationId": "cq_cqk",
          "notes": "漫步古镇石板路，选购陈麻花等地道特产"
        },
        {
          "time": "19:30",
          "activity": "洪崖洞民俗风貌区夜景",
          "type": "POI",
          "locationId": "cq_hyd",
          "notes": "约 20:00 开灯，千厮门大桥上是最佳拍摄机位"
        }
      ]
    }
  ]
};

    let selectedCategory = "全部";

    // Initialize App
    document.addEventListener("DOMContentLoaded", () => {
      renderCategoryFilters();
      renderLocations(travelData.locations);
      renderItinerary(travelData.itinerary);
    });

    // Switch Navigation Tabs
    function switchTab(tab) {
      const locBtn = document.getElementById("nav-locations");
      const itiBtn = document.getElementById("nav-itinerary");
      const locView = document.getElementById("view-locations");
      const itiView = document.getElementById("view-itinerary");

      if (tab === "locations") {
        locBtn.className = "flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm";
        itiBtn.className = "flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900";
        locView.classList.remove("hidden");
        itiView.classList.add("hidden");
      } else {
        itiBtn.className = "flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 bg-white text-slate-900 shadow-sm";
        locBtn.className = "flex items-center space-x-2 px-4 py-2 rounded-lg transition-all duration-200 text-slate-600 hover:text-slate-900";
        itiView.classList.remove("hidden");
        locView.classList.add("hidden");
      }
    }

    // Render Categories
    function renderCategoryFilters() {
      const categories = ["全部", ...new Set(travelData.locations.map(l => l.category))];
      const container = document.getElementById("category-filters");
      
      container.innerHTML = categories.map(cat => `
        <button onclick="selectCategory('${cat}')" class="px-3 py-1.5 rounded-xl text-xs font-medium whitespace-nowrap transition-colors ${
          cat === selectedCategory 
            ? 'bg-rose-500 text-white shadow-sm' 
            : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
        }">
          ${cat}
        </button>
      `).join('');
    }

    // Select Category
    function selectCategory(cat) {
      selectedCategory = cat;
      renderCategoryFilters();
      filterLocations();
    }

    // Filter Locations
    function filterLocations() {
      const query = document.getElementById("search-input").value.toLowerCase();
      const filtered = travelData.locations.filter(loc => {
        const matchesCategory = selectedCategory === "全部" || loc.category === selectedCategory;
        const matchesSearch = loc.name.toLowerCase().includes(query) || loc.address.toLowerCase().includes(query) || loc.description.toLowerCase().includes(query);
        return matchesCategory && matchesSearch;
      });
      renderLocations(filtered);
    }

    // Render Locations Cards
    function renderLocations(locations) {
      const grid = document.getElementById("locations-grid");
      if (locations.length === 0) {
        grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400">未找到相关景点</div>`;
        return;
      }

      grid.innerHTML = locations.map(loc => `
        <div onclick="openModal('${loc.id}')" class="bg-white rounded-2xl p-5 border border-slate-100 shadow-sm hover:shadow-md transition-all cursor-pointer flex flex-col justify-between group">
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="px-2.5 py-1 bg-rose-50 text-rose-600 rounded-lg text-xs font-semibold">${loc.category}</span>
              <span class="text-xs text-slate-400"><i class="fa-solid fa-city mr-1"></i>${loc.city}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 group-hover:text-rose-500 transition-colors">${loc.name}</h3>
            <p class="text-xs text-slate-500 flex items-start space-x-1">
              <i class="fa-solid fa-location-dot text-slate-400 mt-0.5"></i>
              <span class="line-clamp-1">${loc.address}</span>
            </p>
            <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">${loc.description}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-50 flex justify-end text-xs font-semibold text-rose-500 group-hover:translate-x-1 transition-transform">
            查看详情 <i class="fa-solid fa-arrow-right ml-1 self-center"></i>
          </div>
        </div>
      `).join('');
    }

    // Render Itinerary Timeline
    function renderItinerary(itinerary) {
      const container = document.getElementById("itinerary-timeline");

      container.innerHTML = itinerary.map(day => `
        <div class="bg-white rounded-2xl p-6 border border-slate-100 shadow-sm space-y-6">
          <div class="flex items-center space-x-3 pb-4 border-b border-slate-100">
            <div class="w-8 h-8 rounded-full bg-rose-500 text-white flex items-center justify-center font-bold text-sm">
              ${day.day}
            </div>
            <h3 class="text-lg font-bold text-slate-900">${day.title}</h3>
          </div>

          <div class="relative pl-6 space-y-6 before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
            ${day.steps.map(step => {
              const location = travelData.locations.find(l => l.id === step.locationId);
              let typeClass = 'badge-poi';
              let typeLabel = '景点';
              if(step.type === 'Food') { typeClass = 'badge-food'; typeLabel = '美食'; }
              if(step.type === 'Transport') { typeClass = 'badge-transport'; typeLabel = '交通'; }

              return `
                <div class="relative group">
                  <div class="absolute -left-[19px] top-1 w-3 h-3 rounded-full bg-white border-2 border-rose-500"></div>
                  <div class="bg-slate-50 rounded-xl p-4 space-y-2 border border-slate-100">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                      <div class="flex items-center space-x-2">
                        <span class="text-xs font-bold text-slate-400"><i class="fa-regular fa-clock mr-1"></i>${step.time}</span>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold ${typeClass}">${typeLabel}</span>
                      </div>
                      ${location ? `
                        <button onclick="openModal('${location.id}')" class="text-xs text-rose-500 hover:underline font-medium">
                          <i class="fa-solid fa-arrow-up-right-from-square mr-1"></i>查看地标
                        </button>
                      ` : ''}
                    </div>
                    <h4 class="font-bold text-slate-800 text-base">${step.activity}</h4>${step.notes ? `<p class="text-xs text-slate-500"><i class="fa-regular fa-lightbulb mr-1 text-amber-500"></i>${step.notes}</p>` : ''}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `).join('');
    }

    // Modal Control Functions
    function openModal(locationId) {
      const loc = travelData.locations.find(l => l.id === locationId);
      if (!loc) return;

      document.getElementById("modal-category").innerText = loc.category;
      document.getElementById("modal-title").innerText = loc.name;
      document.getElementById("modal-address").innerText = loc.address;
      document.getElementById("modal-description").innerText = loc.description;

      const backdrop = document.getElementById("modal-backdrop");
      backdrop.classList.remove("hidden");
      setTimeout(() => {
        backdrop.classList.remove("opacity-0");
        backdrop.firstElementChild.classList.remove("scale-95");
      }, 10);
    }

    function closeModal() {
      const backdrop = document.getElementById("modal-backdrop");
      backdrop.classList.add("opacity-0");
      backdrop.firstElementChild.classList.add("scale-95");
      setTimeout(() => {
        backdrop.classList.add("hidden");
      }, 300);
    }
  </script>
</body>
</html>
